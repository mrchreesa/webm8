# Server-only Supabase access for the /movers/ review-request route.
# Never add a NEXT_PUBLIC_ prefix to either value: they must not reach a browser.
# Find both in Supabase > Project Settings > API keys (use the `sb_secret_` key,
# not the disabled legacy service_role key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Resend API key for the /demo/ emails (the notification to WebM8 and the
# visitor's confirmation). Server-only: never add a NEXT_PUBLIC_ prefix. Without
# it, /demo/ requests are still saved, but no email is sent.
RESEND_API_KEY=

# Meta Pixel ID. Leave blank to keep the pixel off entirely; the Lead event
# for an accepted review request cannot fire until this is set.
# Configure each deployment's own ID; Instant Websites uses PageView only.
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only, same secret as the CRM's WEBSITE_INTAKE_SECRET.
CRM_WEBSITE_INTAKE_URL=https://webm8-crm.vercel.app/api/webhooks/website
WEBSITE_INTAKE_SECRET=

# Native browser journeys. Off in browsers that send Do Not Track or Global Privacy Control.
NEXT_PUBLIC_WEBM8_ANALYTICS_SITE_ID=
NEXT_PUBLIC_WEBM8_TRACKER_URL=https://webm8-platform.vercel.app/tracker.js

# Separate Instant Websites review project only. These do not enable billing.
# Leave unset on the main agency deployment.
INSTANT_WEBSITES_PREVIEW=
INSTANT_WEBSITES_SITE=

# Instant Websites billing: keep disabled until sandbox verification and setup.
# Production uses its own restricted key; never reuse CRM's billing-read key.
# Save keys as Vercel Sensitive variables, never NEXT_PUBLIC_ server secrets.
INSTANT_BILLING_ENABLED=
INSTANT_STRIPE_MODE=test
INSTANT_WEBSITES_ORIGIN=http://127.0.0.1:3057
STRIPE_RESTRICTED_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Live account WebM8: prod_Vb8QuLgWtXkWKt / price_1UZw9PBgZAK4OqdMp4l3240z.
# Use a separate sandbox price when INSTANT_STRIPE_MODE=test.
STRIPE_INSTANT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_INSTANT_PORTAL_CONFIG=
STRIPE_INSTANT_PORTAL_URL=
# Dedicated database/role restricted to the instant_websites schema.
INSTANT_DATABASE_URL=

# Instant signup emails: only after confirmed checkout AND CRM brief receipt.
# RESEND_API_KEY above must be restricted to sending from webm8agency.com.
INSTANT_EMAILS_ENABLED=
INSTANT_NOTIFICATION_EMAIL=info@webm8agency.com
# Random server-only secret (at least 32 characters) for the retry schedule.
CRON_SECRET=
