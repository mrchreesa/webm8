# Hosted form endpoint for the /movers preview form.
# Formspree example: https://formspree.io/f/your-form-id
NEXT_PUBLIC_MOVERS_FORM_ENDPOINT=

# Optional scheduling link shown after a successful form submission.
# Example: https://cal.com/your-name/website-preview
NEXT_PUBLIC_CALENDAR_URL=

# Mixpanel project token. Leave blank to disable website measurement.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Keep this EU address when the Mixpanel project uses EU data residency.
# Use https://api.mixpanel.com for a US project.
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
